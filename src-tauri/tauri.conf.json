{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitOut",
  "version": "../package.json",
  "identifier": "me.louisclaridge.gitout",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitOut",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "A lightweight git client",
    "longDescription": "GitOut is a fast, lightweight, cross-platform desktop git client.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "depends": ["git"] },
      "rpm": { "depends": ["git"] }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFRUY5NUNCNTRDRUZFRDMKUldUVC9zNVV5NVh2cm5GWkVPTDdFOWRqdHQyazZzQmRSTG9wbVJMU3RVVDMzWmZMSFVZb291R2wK",
      "endpoints": [
        "https://github.com/louisjclaridge/GitOut/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
